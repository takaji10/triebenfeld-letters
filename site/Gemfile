source "https://rubygems.org"

# Matches the Jekyll version GitHub Pages runs, so local builds and the
# deployed site stay identical. No custom plugins: GitHub Pages runs Jekyll
# in safe mode and would ignore them.
gem "jekyll", "~> 3.10.0"

# GitHub Pages parses Markdown as kramdown-with-GFM; match it locally.
gem "kramdown-parser-gfm", "~> 1.1"

gem "webrick", "~> 1.8"   # not bundled with Ruby 3+, needed by `jekyll serve`

# Dropped from Ruby's default gems in 3.4; pinned so builds stay quiet and stable.
gem "base64"
gem "bigdecimal"

platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
